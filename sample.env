# =============================================================================
# AnonX_3 MINIMAL .env — only what you must set
# Everything else is dynamic/auto inside config.py (no keys needed)
# =============================================================================

API_ID=
API_HASH=
BOT_TOKEN=
MONGO_URL=mongodb://localhost:27017/AnonX_3
LOGGER_ID=
OWNER_ID=
SESSION=

# Optional
# SUPPORT_CHANNEL=
# SUPPORT_CHAT=
# OWNER_USERNAME=
# STARTGROUP_BOTS=
# YOUTUBE_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_FAST_MODEL=deepseek-v4-flash
# DEEPSEEK_REVIEW_ENABLED=true
# DEEPSEEK_REVIEW_MODEL=
# DEEPSEEK_REVIEW_TIMEOUT_SEC=8
# DEEPSEEK_ASSISTANT_TIMEOUT_SEC=35
# DEEPSEEK_FAST_TIMEOUT_SEC=15
# DEEPSEEK_AUTH_FAILURE_COOLDOWN_SEC=3600
# Local VPS proxy (default auto — port scan + YouTube live probe, no key needed)
# YOUTUBE_PROXY=auto
# YOUTUBE_PROXY=off
# YOUTUBE_PROXY=socks5h://127.0.0.1:1080
# YOUTUBE_PROXY_CANDIDATES=1080,7890,10808
# YOUTUBE_PROXY_RELOAD_SEC=120
# YOUTUBE_PROXY_VALIDATE=true
# Static cookie file mode - cookies always used from /root/youtube-cookies.txt
COOKIE_FREE_MODE=False
# Static cookie file mode - auth recovery disabled (cookies externally managed)
COOKIE_AUTH_RECOVERY_ENABLED=False
# One explicit YouTube sign-in/bot gate opens a short global circuit so
# parallel audio/video/quality workers do not amplify the same blocked request.
# YOUTUBE_AUTH_CHALLENGE_COOLDOWN_SEC=180
# Static cookie file mode - bot reads /root/youtube-cookies.txt (managed externally)
# Bot does NOT launch browsers or extract cookies; youtube-cookie-guard handles refresh
AUTO_COOKIE_ENABLED=False
COOKIE_BROWSER=firefox
COOKIE_BROWSER_PROFILE=/root/firefox-profile
# Docker Compose host-side bind; set an absolute VPS path when preferred.
COOKIE_BROWSER_PROFILE_HOST=/root/firefox-profile
COOKIE_BROWSER_WARMUP=False
# Static YouTube cookie file (externally managed by youtube-cookie-guard)
YOUTUBE_COOKIE_FILE=/root/youtube-cookies.txt
YOUTUBE_COOKIE_FILE_HOST=/root/youtube-cookies.txt
YTDLP_BINARY=/usr/local/bin/yt-dlp
YTDLP_JS_RUNTIME=deno:/usr/local/bin/deno
YTDLP_REMOTE_COMPONENTS=ejs:github
YTDLP_POT_SERVER_HOME=/root/bgutil-ytdlp-pot-provider/server
COOKIE_BROWSER_TIMEOUT_SEC=30
# COOKIE_REFRESH_SEC=21600
# COOKIE_EXPIRY_WINDOW_SEC=604800
# COOKIE_FAILURE_COOLDOWN_SEC=300
# Real-time cookie watcher - observes the configured Firefox/source profile
# COOKIE_WATCHER_ENABLED=True
# COOKIE_WATCHER_USER_DATA_DIR=/root/youtube-profile
# COOKIE_WATCHER_INTERVAL_SEC=60
# COOKIE_WATCHER_YOUTUBE_ONLY=True
# Optional self-hosted Downloader API (requires the API dependencies)
# DOWNLOADER_API_ENABLED=False
# DOWNLOADER_API_HOST=127.0.0.1
# DOWNLOADER_API_PORT=8000

# ── Resource limits ──
# These five stay the *fallback contract*: if Dynamic Resource Control is
# disabled or errors out, every lane is pinned to exactly these numbers.
# MAX_YTDLP_CONCURRENT=2
# MAX_DOWNLOAD_CONCURRENT=2
# MAX_FFMPEG_CONCURRENT=3
# MAX_VIDEO_JOBS=1
# MAX_ACTIVE_STREAMS=20

# ── Dynamic Resource Control ──
# Raises capacity when many groups /play at once on an idle box, lowers it when
# CPU/RAM/load/event-loop-lag says the box is hurting. Foreground playback is
# always served before background cache/prefetch/thumbnail work, running VC and
# FFmpeg jobs are never cut, and there is no unlimited-worker mode.
# DYNAMIC_RESOURCE_CONTROL=True
# Hard bound on growth: ceiling <= fixed limit * this (also bounded by cores/RAM).
# DYNAMIC_CAPACITY_MAX_MULTIPLIER=4.0
# Grow only while normalized pressure is below this (0.0-1.0).
# DYNAMIC_PRESSURE_GROW_BELOW=0.55
# At/above this pressure every lane is pulled down to its floor.
# DYNAMIC_PRESSURE_RELIEF=0.85
# Event-loop lag treated as full pressure — the VC-stutter predictor.
# DYNAMIC_LOOP_LAG_HIGH_MS=250
# DYNAMIC_LOAD_PER_CORE_HIGH=1.5
# DYNAMIC_RECOMPUTE_INTERVAL_SEC=2
# Pause background admission while any foreground /play or /vplay is waiting.
# DYNAMIC_BACKGROUND_PAUSE=True
# Permits per lane kept free for foreground even when background is queued.
# DYNAMIC_FOREGROUND_RESERVE=1
# Per-lane overrides. 0 = derive from cores/RAM/multiplier (recommended).
# DYNAMIC_YTDLP_CEILING=0
# DYNAMIC_DOWNLOADS_CEILING=0
# DYNAMIC_VIDEO_CEILING=0
# DYNAMIC_FFMPEG_CEILING=0
# DYNAMIC_STREAMS_CEILING=0
# DYNAMIC_YTDLP_FLOOR=0
# DYNAMIC_DOWNLOADS_FLOOR=0
# DYNAMIC_VIDEO_FLOOR=0
# DYNAMIC_FFMPEG_FLOOR=0
# DYNAMIC_STREAMS_FLOOR=0

# ── Stream scaling ──────────────────────────────────────────────────────
# MAX_ACTIVE_STREAMS is the BASELINE, not the cap. Leave
# DYNAMIC_STREAMS_CEILING=0 so the safe ceiling is derived at runtime from
# CPU, RAM, event-loop lag, active streams and refused stream requests; when
# the baseline fills, capacity grows as far as the VPS can carry. Under load
# only new admissions are throttled — active voice chats are never cut.
# A relayed VC stream costs one ntgcalls pipe plus its loop share, so it is
# sized with its own units instead of the download lane's per-job RAM.
# DYNAMIC_STREAM_RAM_MB=24
# DYNAMIC_STREAMS_PER_CORE=16
# DYNAMIC_STREAM_RAM_RESERVE_MB=512
# DYNAMIC_STREAM_DEMAND_WINDOW_SEC=20
# DYNAMIC_STREAM_HEADROOM=2

# MAX_MEDIA_DURATION_SEC=3600
# MAX_DOWNLOAD_MB=512
# Telegram reply/link downloads use this independent ceiling (default 3GB).
# Files above the Bot API getFile limit automatically use assistant MTProto.
# DOWNLOAD_LIMIT_GB=3
# PRELOAD_DEPTH=1
# GAPLESS_PLAYBACK_ENABLED=True
# CROSSFADE_ENABLED=False
# CROSSFADE_SECONDS=2.5
# SILENCE_TRIM_ENABLED=False
# LOUDNESS_NORMALIZATION_ENABLED=False
# ADAPTIVE_RAM_HIGH=88
# ADAPTIVE_RAM_RECOVER=78
# SOURCE_FAILURE_THRESHOLD=3
# SOURCE_COOLDOWN_SECONDS=60
# QUEUE_LIMIT=25
# PLAYLIST_LIMIT=25

# ── CDN / Cache ──
# CDN_ENABLED=True
# CDN_TTL_HOURS=24
# CDN_POPULAR_TTL_HOURS=48
# CDN_UNCOMMON_TTL_HOURS=6
# DISK_HIGH_WATER_PCT=85
# DISK_TARGET_PCT=75

# ── Playback ──
# DIRECT_URL_PROBE=off
# DIRECT_AUDIO_PROBE=False
# DIRECT_PREVALIDATED_RAW_AUDIO=True  # bypass PyTgCalls duplicate MediaStream.check_stream for proven direct audio
# FFMPEG_BINARY=ffmpeg  # resolved to an absolute executable before raw NTgCalls launch
# DIRECT_RAW_OBSERVER=False  # enable only for raw ffmpeg event-file debugging
# DIRECT_RAW_LAUNCH_PROBE_TIMEOUT_SEC=3  # boot-time local Boost-safe ffmpeg launcher probe
# DIRECT_VC_METADATA_PREWARM=True  # warm group-call metadata without joining VC
# DIRECT_STARTUP_V4=True  # audio-first binding owner; False is emergency rollback
# DIRECT_VC_METADATA_TTL_SEC=20
# DIRECT_VC_NATIVE_PREWARM=True  # pre-create local NTgCalls payload only; Telegram JoinGroupCall still waits for source-ready
# DIRECT_VC_NATIVE_PREWARM_TTL_SEC=12
# DIRECT_VC_DEFER_SOURCE_REFRESH=True  # defer incoming-source refresh until after initial raw audio attach
# DIRECT_VC_UNMUTE_OVERLAP=True  # retry self-unmute after source-ready while WebRTC connect is still running
# DIRECT_VC_UNMUTE_INITIAL_DELAY_MS=300
# DIRECT_VC_UNMUTE_RETRY_MS=100
# DIRECT_VC_UNMUTE_ATTEMPTS=5
# DIRECT_FIRST_PACKET_POLL_MS=20  # local NTgCalls outgoing-clock poll during initial startup
# DIRECT_EXTERNAL_PREBUFFER_AUDIO=True  # predecode validated remote audio while late VC join connects
# DIRECT_EXTERNAL_PREBUFFER_FRAMES=4  # 4x10ms PCM runway; lower activation tail
# DIRECT_VIDEO_AUDIO_LEAD_PACKET_TIMEOUT_SEC=0.40
# DIRECT_EXTERNAL_PREBUFFER_READY_TIMEOUT_SEC=0.35  # bounded post-connect wait if network decode is unusually slow
# DIRECT_RAW_COLD_PATH=False  # legacy opt-in raw path for video/experiments
# DIRECT_FAILOVER_WINDOW_SEC=45
# DIRECT_START_PROOF_SEC=3
# DIRECT_MIDSTREAM_FAILOVER=True
# YOUTUBE_DIRECT_CACHE_BG=False
# FALLBACK_SOUNDCLOUD=True
# FALLBACK_MIN_SCORE=0.85
# FALLBACK_QUERY_ATTEMPTS=2
# PLAY_RESOLVE_TIMEOUT_SEC=18
# SOUNDCLOUD_PROXY_TIMEOUT_SEC=4
# SOUNDCLOUD_DIRECT_TIMEOUT_SEC=5
# SOUNDCLOUD_CANDIDATE_PROBE_LIMIT=3

# ── Social share links (TikTok story/photo, Facebook watch/reel/share) ──
# Share and shortener links hide their target behind a redirect, so resolving
# them needs one bounded HTTP request. Off = offline URL rewrite only, which
# still fixes story/photo/subdomain links but not share/fb.watch links.
# SOCIAL_URL_RESOLVE_ENABLED=True
# SOCIAL_URL_RESOLVE_TIMEOUT_SEC=8
# SOCIAL_URL_RESOLVE_MAX_HOPS=5
# SOCIAL_URL_CACHE_TTL_SEC=3600
# A failed hop is remembered this long, so an unreachable provider cannot
# stall foreground /play once per attempt.
# SOCIAL_URL_NEGATIVE_TTL_SEC=60

# ── Distributed singleflight (optional Redis) ──
# SINGLEFLIGHT_BACKEND=memory
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_LOCK_TTL_SEC=120
# REDIS_RESULT_TTL_SEC=300

# ── PO Token Provider (optional sidecar) ──
# Official bgutil provider plugin + matching long-lived HTTP sidecar.
PO_TOKEN_PROVIDER_ENABLED=True
# Blank/auto URL resolves to http://127.0.0.1:4416 when enabled.
PO_TOKEN_PROVIDER_URL=http://127.0.0.1:4416
POT_PROVIDER_URL=http://127.0.0.1:4416
# Recommended by current yt-dlp PO guidance for GVS media requests.
# PO_TOKEN_CLIENT=mweb
# Foreground mweb resolver latency tuning (default enabled).
# Uses yt-dlp's mweb ad-playback context to avoid the mandatory wait and
# skips only the unneeded initial_data request. Set False to rollback either.
# DIRECT_MWEB_USE_AD_PLAYBACK_CONTEXT=True
# DIRECT_MWEB_SKIP_INITIAL_DATA=True
# DIRECT_MWEB_LIGHTWEIGHT=True
# DIRECT_MWEB_MICRO_PLAYER=True  # one mweb player API call for direct itag18; guarded full-extractor fallback
# DIRECT_RESOLVER_PREWARM=True
# DIRECT_RESOLVER_WORKERS=2
# DIRECT_FOREGROUND_RESOLVER_SLOTS=2  # dedicated cold direct race slots; independent of dynamic/background yt-dlp throttle
# Pre-create sticky direct-resolver runtime objects at app startup.
# DIRECT_RESOLVER_STARTUP_WARM=True
# DIRECT_RESOLVER_STARTUP_WARM_TIMEOUT_SEC=4.0
# Dual-stage audio quality promotion (foreground fast, exact 140 in background).
# DIRECT_BACKGROUND_140_ENABLED=True
# DIRECT_BACKGROUND_140_TTL_SEC=600
# Dedicated slow-140 workers; isolated from foreground resolver workers.
# DIRECT_BACKGROUND_140_WORKERS=1
# PO_TOKEN_CACHE_SEC=300
# POT_TOKEN_HEALTH_COOLDOWN_SEC=1800

# ── Automatic reply learning ──
# Same keyword/answer pair observations required before auto activation.
# Explicit /reply rules remain immediate.
# AUTO_LEARN_CONFIRMATIONS=2

# ── Health / Observability ──
# HEALTH_PORT=0
# HEALTH_HOST=127.0.0.1
# HEALTH_TOKEN=

